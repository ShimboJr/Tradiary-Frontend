# ─── API ──────────────────────────────────────────────────────────────────────
# In dev, Vite proxies /api → localhost:5000, so this is only needed for production
VITE_API_URL=http://localhost:5000/api

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorised origins must include http://localhost:5173 for dev
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
